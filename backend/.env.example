SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
# Comma-separated. Add a tunnel's host here too if you're exposing the
# backend through one (e.g. ngrok http 8000) -- Django rejects any request
# whose Host header isn't in this list with a 400 "DisallowedHost" error,
# e.g.: ALLOWED_HOSTS=localhost,127.0.0.1,xxxx.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call this API via CORS. Defaults to
# FRONTEND_URL alone when unset. Add a tunneled frontend URL here too if
# you're exposing it through one (e.g. ngrok http 5173), e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://xxxx.ngrok-free.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase 13 — get a free key at https://openweathermap.org/api (Sign Up → API keys tab)
OPENWEATHER_API_KEY=

# Phase 14 — get a free key at https://console.cloud.google.com/apis/credentials
# (create a project → enable "YouTube Data API v3" → Credentials → Create API Key)
YOUTUBE_API_KEY=

# Farming Diary AI analysis — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — only change if Google retires the default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Email — real sending for verification/password-reset links.
# Leave EMAIL_BACKEND unset (console backend) to keep printing emails to the
# runserver terminal instead of sending them. To send for real with Gmail:
#   1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (name it anything, e.g. "smart-farming") — Google gives you a 16-character code
#   3. Set EMAIL_HOST_USER to the full Gmail address, EMAIL_HOST_PASSWORD to that
#      16-character App Password (NOT your normal Gmail password), and switch
#      EMAIL_BACKEND to the smtp line below.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Caps how long a single SMTP send can block (seconds). Keeps a stalled mail
# server from outlasting the frontend's 8s request timeout -- see settings.py.
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=FARMAI <your-address@gmail.com>
