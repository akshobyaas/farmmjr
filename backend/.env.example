SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

FRONTEND_URL=http://localhost:5173

# Phase 13 — get a free key at https://openweathermap.org/api (Sign Up → API keys tab)
OPENWEATHER_API_KEY=

# Phase 14 — get a free key at https://console.cloud.google.com/apis/credentials
# (create a project → enable "YouTube Data API v3" → Credentials → Create API Key)
YOUTUBE_API_KEY=
